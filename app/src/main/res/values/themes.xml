<resources xmlns:tools="http://schemas.android.com/tools">


    <!-- Base application theme. -->
    <style name="Theme.PolicyBossPro" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorSecondary">@color/blue</item>
    </style>

    <!-- Splash Theme -->
    <style
        name="Theme.PolicyBossPro.Splash"
        parent="Theme.SplashScreen">

        <!-- background color -->
        <item name="windowSplashScreenBackground">
            @color/white
        </item>

        <!-- app icon -->
        <item name="windowSplashScreenAnimatedIcon">
            @mipmap/ic_launcher
        </item>

        <!-- after splash -->
        <item name="postSplashScreenTheme">
            @style/Theme.PolicyBossPro
        </item>

    </style>

    <!-- Title Text Style for Welcome Slides -->
    <style name="TextStyle.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Medium/Body Text Style for Welcome Slides -->
    <style name="TextStyle.TextMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Modern MaterialCheckBox Style conforming to Material 3 / Material Components -->
    <style name="MaterialCheckBoxStyle" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/blue</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>